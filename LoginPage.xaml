<Page x:Class="PersonalMediaLibrary.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход в систему"
      Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF000000" Height="40">
            <TextBlock Text="Личная медиатека" 
                       Foreground="{StaticResource AccentLightBrush}" 
                       FontFamily="Roboto" FontSize="14"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Border>

        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Width="360">

            <Image Source="logo.png" 
                   Width="120" Height="120" 
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

            <TextBlock Text="Вход в систему" 
                       Style="{StaticResource HeaderTextStyle}"/>

            <TextBlock Text="Электронная почта" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="EmailTextBox" Style="{StaticResource TextBoxStyle}"/>

            <TextBlock Text="Пароль" Style="{StaticResource LabelStyle}"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordBoxStyle}"/>

            <Button Content="Войти" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnLoginClick"/>

            <TextBlock Text="Нет аккаунта? Зарегистрироваться"
                       Style="{StaticResource LinkTextStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       MouseLeftButtonDown="OnRegisterLinkClick"/>
        </StackPanel>
    </Grid>
</Page>